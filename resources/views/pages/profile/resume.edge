        <!--Personal Details-->
        <div class="panel panel-default mb-3">
          <div class="panel-heading wt-panel-heading p-a20 panel-heading-with-btn ">
            <h4 class="panel-tittle m-a0">
              Details personnels
            </h4>
            <a
              data-bs-toggle="modal"
              href="#Personal_Details"
              role="button"
              title="Edit"
              class="site-text-primary"
            >
              <span class="fa fa-edit"></span>
            </a>
          </div>
          <div class="panel-body wt-panel-body p-a20 ">
            <div class="twm-panel-inner">
              <div class="row">

                <div class="row">
                  <div class="col-md-6">
                    <div class="twm-s-detail-section">
                      <div class="twm-title">
                        Nom
                      </div>
                      <span class="twm-s-info-discription">{{ profile.name || 'N/A' }}</span>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="twm-s-detail-section">
                      <div class="twm-title">
                        Prénom
                      </div>
                      <span class="twm-s-info-discription">{{ profile.name || 'N/A' }}</span>
                    </div>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="twm-s-detail-section">
                    <div class="twm-title">
                      Date de naissance
                    </div>
                    <span class="twm-s-info-discription">
                      {{ profile.birthDate 
                         ? new Date(profile.birthDate).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' }) 
                         : 'N/A' }}
                    </span>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="twm-s-detail-section">
                    <div class="twm-title">
                      Adresse
                    </div>
                    <span class="twm-s-info-discription">{{ profile.address || 'N/A' }}</span>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="twm-s-detail-section">
                    <div class="twm-title">
                      Sexe
                    </div>
                    <span class="twm-s-info-discription">{{ profile.sex || 'N/A' }}</span>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="twm-s-detail-section">
                    <div class="twm-title">
                      Statut matrimonial
                    </div>
                    <span class="twm-s-info-discription">{{ profile.status || 'N/A' }}</span>
                  </div>
                </div>

              </div>
            </div>
          </div>

          <!--Personal Details Modal -->
          <div class="modal fade twm-saved-jobs-view" id="Personal_Details" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <form action="{{ route('user-profile.update') }}" method="post" id="profileForm">
                  {{ csrfField() }}
                  <div class="modal-header">
                    <h2 class="modal-title">
                      Details Personnels
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>

                  <div class="modal-body">

                    <div class="row">
                      <!--Birth Date-->
                      <div class="col-xl-12 col-lg-12">
                        <div class="form-group">
                          <label>Date de naissance</label>
                          <div class="ls-inputicon-box">
                            <input
                              class="form-control"
                              name="birthDate"
                              type="date"
                              placeholder="Entrer votre date de naissance"
                              value="{{ profile.birthDate || '' }}"
                              
                            />
                            <i class="fs-input-icon far fa-calendar"></i>
                          </div>
                        </div>
                      </div>

                      <div class="col-xl-12 col-lg-12">
                        <div class="form-group">
                          <label>Genre</label>
                          <div class="row twm-form-radio-inline">

                            <div class="col-md-6">
                              <input
                                class="form-check-input"
                                type="radio"
                                name="sex"
                                id="S_male"
                                value="Homme"
                                {{ profile.sex === 'Homme' ? 'checked' : '' }}
                              />
                              <label class="form-check-label" for="S_male">
                                Homme
                              </label>
                            </div>
                            <div class="col-md-6">
                              <input
                                class="form-check-input"
                                type="radio"
                                name="sex"
                                id="S_female"
                                value="Femme"
                                {{ profile.sex === 'Femme' ? 'checked' : '' }}
                              />
                              <label class="form-check-label" for="S_female">
                                Femme
                              </label>
                            </div>
                          </div>

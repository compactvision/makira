      <!--Profile Summary-->
      <div class="panel panel-default mb-3">
        <div class="panel-heading wt-panel-heading p-a20 panel-heading-with-btn ">
          <h4 class="panel-tittle m-a0">
            Résumé du profil
          </h4>
          <a
            data-bs-toggle="modal"
            href="#Profile_Summary"
            role="button"
            title="Edit"
            class="site-text-primary"
          >
            <span class="fa fa-edit"></span>
          </a>
        </div>
        <div class="panel-body wt-panel-body p-a20 ">
          <div class="twm-panel-inner">
            <p>
              {{ candidate.summary || 'Aucun résumé' }}
            </p>
          </div>
        </div>
        <!--Modal Popup -->
        <div class="modal fade twm-saved-jobs-view" id="Profile_Summary" tabindex="-1">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <form method="POST" action="{{ route('update') }}">
                {{ csrfField() }}
                <div class="modal-header">
                  <h2 class="modal-title">
                    Résumé du profil
                  </h2>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                  <p>
                    Votre résumé de profil doit mentionner les points forts de votre carrière et de votre formation, vos intérêts professionnels et le type de carrière que vous recherchez. Rédigez un résumé pertinent de plus de 50 caractères.
                  </p>

                  <div class="row">
                    <div class="col-lg-12 col-md-12">
                      <div class="form-group twm-textarea-full">
                        <textarea class="form-control" name="summary" placeholder="Detail of Project"></textarea>
                      </div>
                    </div>
                  </div>

                </div>

                <div class="modal-footer">

                  <button type="button" class="site-button" data-bs-dismiss="modal">Fermer</button>
                  <button type="submit" class="site-button">Enregistrer</button>

                </div>

              </form>
            </div>
          </div>
        </div>
      </div>

      <form action="{{ route('send-cv') }}" method="POST">
        {{ csrfField() }}
        <button class="site-button" type="submit">{{ candidate.isActive ? 'Retirer mon CV' : 'Envoyer mon CV' }}</button>
      </form>

    </div>
  </div>

  <script>
    function updateSkillsCounter() {
      const input = document.getElementById('skillsInput');
      const counter = document.getElementById('skillsCounter');
      const skills = input.value.split(',').filter(skill => skill.trim() !== '');
      counter.textContent = `${skills.length} compétence(s) saisie(s)`;
    }

    document.getElementById('skillsForm').addEventListener('submit', function (event) {
      const input = document.querySelector('input[name="skills"]');
      const skillsArray = input.value.split(',').map(skill => skill.trim()).filter(skill => skill !== '');

      console.log("Converted skills:", skillsArray); // Debug ici

      input.value = JSON.stringify(skillsArray);
    });

    document.addEventListener("DOMContentLoaded", () => {
          const form = document.querySelector("#profileForm");
          if (form) {
            form.addEventListener("submit", async event => {
              event.preventDefault();
              const formData = new FormData(form);
              const csrfToken = form.querySelector("input[name=_csrf]").value;
              try {
                const response = await fetch("/user-profile/update", {
                  method: "POST",
                  headers: {
                    "X-CSRF-TOKEN": csrfToken,
                    Accept: "application/json"
                  },
                  body: formData
                });
                if (response.ok) {
                  const result = await response.json();
                  alert(result.message || "Profile updated successfully!");
                } else {
                  const error = await response.json();
                  alert(error.message || "An error occurred while updating profile.");
                }
              } catch (error) {
                console.error("Error:", error);
                alert("Failed to update profile. Please try again later.");
              }
            });
          }
        });
  </script>
@endslot
@endcomponent



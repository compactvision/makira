                    <p class="opacity-80">Accédez à des offres d'emploi adaptées à votre profil</p>
                  </div>
                </div>
                
                <div class="flex items-start space-x-4">
                  <div class="bg-white bg-opacity-20 p-3 rounded-full">
                    <i class="fas fa-chart-line text-xl"></i>
                  </div>
                  <div class="text-left">
                    <h3 class="font-semibold text-lg">Suivi de progression</h3>
                    <p class="opacity-80">Suivez l'évolution de vos candidatures en temps réel</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Section droite - Formulaire -->

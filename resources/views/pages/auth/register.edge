        <div class="grid md:grid-cols-2">
          <!-- Section gauche - Image -->
          <div class="hidden md:flex items-center justify-center p-8 lg:p-12 bg-gradient-to-br from-indigo-500 to-purple-600 relative overflow-hidden">
            <div class="absolute inset-0 bg-black opacity-20"></div>
            <div class="relative z-10 text-center text-white">
              <div class="mb-8 fade-in">
                <img src="images/logo.png" alt="Makira" class="h-20 mx-auto mb-6">
